---
---
<div id="cookie-consent-banner" class="cookie-banner hidden">
  <div class="cookie-content">
    <div class="cookie-text">
      <h4 class="cookie-title">Cookie Policy</h4>
      <p class="cookie-desc">
        We use cookies to analyze web traffic and optimize your browsing experience. By clicking "Accept All", you consent to our use of cookies.
      </p>
    </div>
    <div class="cookie-actions">
      <button id="btn-cookie-reject" class="btn btn-cookie btn-cookie-secondary">Necessary Only</button>
      <button id="btn-cookie-accept" class="btn btn-cookie btn-cookie-primary">Accept All</button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const banner = document.getElementById('cookie-consent-banner');
    const btnAccept = document.getElementById('btn-cookie-accept');
    const btnReject = document.getElementById('btn-cookie-reject');
    
    const consent = localStorage.getItem('portfolio_consent_state');
    
    if (!consent) {
      banner.classList.remove('hidden');
    }
    
    btnAccept.addEventListener('click', () => {
      const consentObj = { analytics: 'granted', date: new Date().toISOString() };
      localStorage.setItem('portfolio_consent_state', JSON.stringify(consentObj));
      banner.classList.add('hidden');
    });
    
    btnReject.addEventListener('click', () => {
      const consentObj = { analytics: 'rejected', date: new Date().toISOString() };
      localStorage.setItem('portfolio_consent_state', JSON.stringify(consentObj));
      banner.classList.add('hidden');
    });
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 25px;
    left: 25px;
    right: 25px;
    max-width: 600px;
    background-color: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--text-primary);
    padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    z-index: 9998;
    transition: all 0.3s ease;
  }
  
  .cookie-banner.hidden {
    display: none;
    pointer-events: none;
    opacity: 0;
  }

  .cookie-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .cookie-content {
      flex-direction: column;
      gap: 1.2rem;
      align-items: flex-start;
    }
  }

  .cookie-text {
    flex: 1;
  }

  .cookie-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
    font-weight: 500;
  }

  .cookie-desc {
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--text-secondary);
  }

  .cookie-actions {
    display: flex;
    gap: 0.8rem;
  }

  @media (max-width: 480px) {
    .cookie-actions {
      width: 100%;
      flex-direction: column;
    }
  }

  .btn-cookie {
    padding: 0.6rem 1.2rem;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    font-weight: 500;
    text-transform: uppercase;
  }

  .btn-cookie-primary {
    background-color: var(--text-primary);
    color: var(--bg-primary);
    border: 1px solid var(--text-primary);
  }

  .btn-cookie-primary:hover {
    background-color: transparent;
    color: var(--text-primary);
  }

  .btn-cookie-secondary {
    background-color: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
  }

  .btn-cookie-secondary:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
  }
</style>
